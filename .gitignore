# Build outputs. `dist` above does not match these, and both are large:
# dist-offline is ~550 KB of emitted CSS/JS, phone/ is the ~550 KB single-file
# artifact that `build:offline` produces for sideloading onto a handset.
# Neither belongs in history: they are reproducible from source with
# `npm run build:offline`.
dist-offline
phone

