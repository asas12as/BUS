# Logs
logs
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# The Supabase CLI writes a resolved-version marker here. It is a cache, it
# changes on every upgrade, and it says nothing about the schema.
supabase/.temp

# Secrets. The Supabase admin key bypasses row-level security entirely, so a
# committed copy would hand anyone full read/write on the database. Vite also
# loads .env* into the bundle, so a stray .env would publish the secret to every
# visitor rather than just to git.
.env
.env.*
!.env.example

# Build output. `dist` above does not match this, and it is ~900 KB of emitted
# CSS/JS. It does not belong in history: it is reproducible from source with
# `npm run build`.
dist

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
