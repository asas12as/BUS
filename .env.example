# Supabase connection. Commit this file; never commit the real values.
#
# Copy to .env.local and fill in from the Supabase dashboard. Only the two
# VITE_ variables belong in the browser bundle. SUPABASE_ADMIN_KEY and
# DB_PASSWORD are read by scripts/ only, never by src/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to ship. Anon key: row-level security decides what it may read.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# DANGEROUS. Bypasses row-level security entirely. Machine-only. Rotating this
# after a one-off migration is the cheap way to shrink the exposure window.
SUPABASE_ADMIN_KEY=sb_secret_your_key_here

# DANGEROUS. Full postgres superuser. Only needed to apply migrations, because
# Supabase exposes no SQL-over-HTTP route and the admin key cannot run DDL.
# Project Settings -> Database -> DB password.
DB_PASSWORD=your_postgres_password_here